<?xml version="1.0" encoding="UTF-8"?>
<changeSet>
  <!--================================================================================================-->
  <!-- REPOSITORY - PART 3 - SIMPLIFY OWNERSHIP AND NAME CHANGES BY ENABLING ON UPDATE CASCADE        -->
  <!--================================================================================================-->

  <!-- drop foreign key constraints that transitively reference REPOSITORY via ISSUE or RELEASE_TAG,
       so they can be re-added with ON UPDATE CASCADE below -->
  <dropForeignKeyConstraint constraintName="IDX_ISSUE_COMMENT_FK0" baseTableName="ISSUE_COMMENT"/>
  <dropForeignKeyConstraint constraintName="IDX_ISSUE_LABEL_FK0" baseTableName="ISSUE_LABEL"/>
  <dropForeignKeyConstraint constraintName="IDX_PULL_REQUEST_FK0" baseTableName="PULL_REQUEST"/>
  <dropForeignKeyConstraint constraintName="IDX_ISSUE_ASSIGNEE_FK0" baseTableName="ISSUE_ASSIGNEE"/>
  <dropForeignKeyConstraint constraintName="IDX_RELEASE_ASSET_FK0" baseTableName="RELEASE_ASSET"/>

  <!-- drop foreign key constraints that directly reference REPOSITORY; they are added back below.
       IDX_COMMIT_STATUS_FK1 (from the 4.0 migration) and IDX_PROTECTED_BRANCH_FK0 (from the 4.42
       migration) already carry ON UPDATE CASCADE and are left untouched. -->
  <dropForeignKeyConstraint constraintName="IDX_COLLABORATOR_FK0" baseTableName="COLLABORATOR"/>
  <dropForeignKeyConstraint constraintName="IDX_COMMIT_COMMENT_FK0" baseTableName="COMMIT_COMMENT"/>
  <dropForeignKeyConstraint constraintName="IDX_LABEL_FK0" baseTableName="LABEL"/>
  <dropForeignKeyConstraint constraintName="IDX_MILESTONE_FK0" baseTableName="MILESTONE"/>
  <dropForeignKeyConstraint constraintName="IDX_ISSUE_FK0" baseTableName="ISSUE"/>
  <dropForeignKeyConstraint constraintName="IDX_ISSUE_ID_FK1" baseTableName="ISSUE_ID"/>
  <dropForeignKeyConstraint constraintName="IDX_DEPLOY_KEY_FK0" baseTableName="DEPLOY_KEY"/>
  <dropForeignKeyConstraint constraintName="IDX_PRIORITY_FK0" baseTableName="PRIORITY"/>
  <dropForeignKeyConstraint constraintName="IDX_RELEASE_TAG_FK0" baseTableName="RELEASE_TAG"/>
  <dropForeignKeyConstraint constraintName="IDX_WEB_HOOK_FK0" baseTableName="WEB_HOOK"/>
  <dropForeignKeyConstraint constraintName="IDX_CUSTOM_FIELD_FK0" baseTableName="CUSTOM_FIELD"/>

  <!-- from 4.0 migration -->
  <addForeignKeyConstraint constraintName="IDX_COLLABORATOR_FK0" baseTableName="COLLABORATOR" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>
  <addForeignKeyConstraint constraintName="IDX_COMMIT_COMMENT_FK0" baseTableName="COMMIT_COMMENT" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>
  <addForeignKeyConstraint constraintName="IDX_LABEL_FK0" baseTableName="LABEL" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>
  <addForeignKeyConstraint constraintName="IDX_MILESTONE_FK0" baseTableName="MILESTONE" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>
  <addForeignKeyConstraint constraintName="IDX_ISSUE_FK0" baseTableName="ISSUE" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>
  <addForeignKeyConstraint constraintName="IDX_ISSUE_ID_FK1" baseTableName="ISSUE_ID" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>

  <!-- from 4.11 migration -->
  <addForeignKeyConstraint constraintName="IDX_DEPLOY_KEY_FK0" baseTableName="DEPLOY_KEY" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>

  <!-- from 4.14 migration -->
  <addForeignKeyConstraint constraintName="IDX_PRIORITY_FK0" baseTableName="PRIORITY" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>

  <!-- from 4.21 migration; table was renamed in 4.23 migration -->
  <addForeignKeyConstraint constraintName="IDX_RELEASE_TAG_FK0" baseTableName="RELEASE_TAG" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>

  <!-- from 4.35 migration and 4.0 migration -->
  <addForeignKeyConstraint constraintName="IDX_WEB_HOOK_FK0" baseTableName="WEB_HOOK" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>

  <!-- from 4.38 migration -->
  <addForeignKeyConstraint constraintName="IDX_CUSTOM_FIELD_FK0" baseTableName="CUSTOM_FIELD" baseColumnNames="USER_NAME, REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE"/>

  <!-- from 4.0 migration -->
  <addForeignKeyConstraint constraintName="IDX_ISSUE_COMMENT_FK0" baseTableName="ISSUE_COMMENT" baseColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" referencedTableName="ISSUE" referencedColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" onUpdate="CASCADE"/>
  <addForeignKeyConstraint constraintName="IDX_ISSUE_LABEL_FK0" baseTableName="ISSUE_LABEL" baseColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" referencedTableName="ISSUE" referencedColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" onUpdate="CASCADE"/>
  <addForeignKeyConstraint constraintName="IDX_PULL_REQUEST_FK0" baseTableName="PULL_REQUEST" baseColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" referencedTableName="ISSUE" referencedColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" onUpdate="CASCADE"/>

  <!-- from 4.38 migration -->
  <addForeignKeyConstraint constraintName="IDX_ISSUE_ASSIGNEE_FK0" baseTableName="ISSUE_ASSIGNEE" baseColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" referencedTableName="ISSUE" referencedColumnNames="USER_NAME, REPOSITORY_NAME, ISSUE_ID" onUpdate="CASCADE"/>

  <!-- from 4.23 migration -->
  <addForeignKeyConstraint constraintName="IDX_RELEASE_ASSET_FK0" baseTableName="RELEASE_ASSET" baseColumnNames="USER_NAME, REPOSITORY_NAME, TAG" referencedTableName="RELEASE_TAG" referencedColumnNames="USER_NAME, REPOSITORY_NAME, TAG" onUpdate="CASCADE"/>

  <!--================================================================================================-->
  <!-- REPOSITORY - PART 4 - SELF-REFERENTIAL FK ON ORIGIN/PARENT WITH ON UPDATE CASCADE              -->
  <!--================================================================================================-->

  <!-- MySQL InnoDB requires indexes on FK referencing columns; H2 and PostgreSQL accept FK
       constraints without them but benefit from the same indexes for cascade performance -->
  <createIndex tableName="REPOSITORY" indexName="IDX_REPOSITORY_ORIGIN">
    <column name="ORIGIN_USER_NAME"/>
    <column name="ORIGIN_REPOSITORY_NAME"/>
  </createIndex>
  <createIndex tableName="REPOSITORY" indexName="IDX_REPOSITORY_PARENT">
    <column name="PARENT_USER_NAME"/>
    <column name="PARENT_REPOSITORY_NAME"/>
  </createIndex>

  <!-- Self-referential FK constraints: renaming a repository row cascades the updated
       (USER_NAME, REPOSITORY_NAME) to any fork that records it as its origin or immediate
       parent; deleting a repository row NULLs those columns on forks rather than removing
       the fork rows -->
  <addForeignKeyConstraint constraintName="IDX_REPOSITORY_FK1" baseTableName="REPOSITORY" baseColumnNames="ORIGIN_USER_NAME, ORIGIN_REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE" onDelete="SET NULL"/>
  <addForeignKeyConstraint constraintName="IDX_REPOSITORY_FK2" baseTableName="REPOSITORY" baseColumnNames="PARENT_USER_NAME, PARENT_REPOSITORY_NAME" referencedTableName="REPOSITORY" referencedColumnNames="USER_NAME, REPOSITORY_NAME" onUpdate="CASCADE" onDelete="SET NULL"/>
</changeSet>
